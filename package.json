{
  "name": "productfilm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "doctor": "node scripts/doctor.ts",
    "dev": "vite build apps/web && node apps/server/main.ts",
    "build": "tsc --noEmit && vite build apps/web",
    "start": "node apps/server/main.ts",
    "lint": "biome lint apps packages scripts tests",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:integration": "node --test tests/integration/*.test.ts",
    "test:e2e": "pnpm build && node --test tests/e2e/*.test.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm test:e2e",
    "verify:live": "node scripts/live.ts",
    "capture:fixture": "node scripts/capture-fixture.ts",
    "render:fixture": "node scripts/render-fixture.ts"
  },
  "dependencies": {
    "@fastify/static": "8.3.0",
    "fastify": "5.12.8",
    "playwright-core": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/darwin-arm64": "4.1.5",
    "@ffprobe-installer/darwin-arm64": "5.0.1"
  }
}
